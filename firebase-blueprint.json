{
  "entities": {
    "inquiry": {
      "title": "Inquiry",
      "description": "An inquiry submitted by a client for accounting or tax consulting services.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the inquiry."
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "description": "Full name of the contact person."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Business email address."
        },
        "phone": {
          "type": "string",
          "maxLength": 50,
          "description": "Contact or WhatsApp phone number."
        },
        "company": {
          "type": "string",
          "maxLength": 150,
          "description": "Company name."
        },
        "serviceType": {
          "type": "string",
          "maxLength": 50,
          "description": "The category of service requested."
        },
        "message": {
          "type": "string",
          "maxLength": 5000,
          "description": "The message body or custom inquiry details."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the inquiry was logged."
        },
        "synced": {
          "type": "boolean",
          "description": "Whether the inquiry has been synced to Google Sheets."
        },
        "status": {
          "type": "string",
          "maxLength": 50,
          "description": "The lead pipeline status (e.g. New Lead, Contacted, In Progress, Converted, Archived)."
        },
        "notes": {
          "type": "string",
          "maxLength": 5000,
          "description": "Internal advisor notes and follow-up logs."
        }
      },
      "required": ["name", "email", "createdAt", "synced", "status"]
    },
    "settings": {
      "title": "Settings",
      "description": "Application and integration settings.",
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "description": "Google OAuth access token."
        },
        "email": {
          "type": "string",
          "description": "Advisor email address."
        },
        "spreadsheetId": {
          "type": "string",
          "description": "The Google Sheets ID where inquiries are synced."
        },
        "tokenExpired": {
          "type": "boolean",
          "description": "Flag indicating if the token has expired."
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of last token update."
        }
      }
    },
    "blogPost": {
      "title": "Blog Post",
      "description": "An authoritative SEO-optimized blog post on UAE tax, accounting, or regulatory trends.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique slug identifier for the blog post."
        },
        "title": {
          "type": "string",
          "description": "Title of the article."
        },
        "summary": {
          "type": "string",
          "description": "Concise summary for previews and meta descriptions."
        },
        "content": {
          "type": "string",
          "description": "Full article content in markdown format."
        },
        "date": {
          "type": "string",
          "description": "Publication date string."
        },
        "readTime": {
          "type": "string",
          "description": "Estimated reading time (e.g. '6 min read')."
        },
        "tag": {
          "type": "string",
          "description": "Primary regulatory category or topic tag."
        },
        "author": {
          "type": "object",
          "description": "Author profile information."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target SEO keywords."
        },
        "schemaMarkup": {
          "type": "string",
          "description": "JSON-LD schema markup for Google search rankings."
        },
        "isAiGenerated": {
          "type": "boolean",
          "description": "Whether this post was generated by the 24-hour Gemini Cloud Function."
        },
        "generatedAt": {
          "type": "string",
          "description": "ISO timestamp of generation."
        },
        "sourceTrends": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of current UAE financial trends referenced."
        }
      },
      "required": ["id", "title", "summary", "content", "date", "tag"]
    },
    "blogQueueItem": {
      "title": "Blog Queue Item",
      "description": "Pending blog content waiting in the queue to be published on scheduled Tuesdays or Fridays.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the queue item."
        },
        "title": {
          "type": "string",
          "description": "Title of the pending blog post."
        },
        "summary": {
          "type": "string",
          "description": "Executive summary or abstract."
        },
        "content": {
          "type": "string",
          "description": "Full markdown content or outline of the article."
        },
        "tag": {
          "type": "string",
          "description": "Category tag (e.g. Corporate Tax, VAT, Free Zones)."
        },
        "readTime": {
          "type": "string",
          "description": "Estimated reading duration."
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Target SEO keywords."
        },
        "targetDay": {
          "type": "string",
          "description": "Preferred scheduled day (Tuesday or Friday)."
        },
        "priority": {
          "type": "number",
          "description": "Ordering priority in queue (1 = highest)."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "published", "archived"],
          "description": "Current status in the publication pipeline."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when queued."
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when published."
        },
        "publishedBlogId": {
          "type": "string",
          "description": "ID of published blog post document."
        },
        "author": {
          "type": "object",
          "description": "Author profile."
        }
      },
      "required": ["id", "title", "content", "status", "createdAt"]
    }
  },
  "firestore": {
    "inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Collection of all service inquiries."
    },
    "settings/{settingId}": {
      "schema": "settings",
      "description": "Advisor settings and integrations."
    },
    "blog_posts/{blogId}": {
      "schema": "blogPost",
      "description": "Collection of published and AI-generated blog posts."
    },
    "blog_queue/{queueId}": {
      "schema": "blogQueueItem",
      "description": "Queue of pending blog posts scheduled to be published on Tuesdays and Fridays."
    }
  }
}
