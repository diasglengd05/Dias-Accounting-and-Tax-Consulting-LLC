{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/home",
        "destination": "https://diasuae.ae/",
        "type": 301
      },
      {
        "source": "/home/",
        "destination": "https://diasuae.ae/",
        "type": 301
      },
      {
        "source": "/home.html",
        "destination": "https://diasuae.ae/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "https://diasuae.ae/",
        "type": 301
      },
      {
        "source": "/tax-planning-difc.html",
        "destination": "https://diasuae.ae/tax-planning-difc",
        "type": 301
      },
      {
        "source": "/blog.html",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/blogs",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/blogs/",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/insights",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/insights/",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/blog/draft-top-tax-mistakes-uae-companies-make",
        "destination": "https://diasuae.ae/blog/top-tax-mistakes-uae-companies-make",
        "type": 301
      },
      {
        "source": "/blogs/draft-top-tax-mistakes-uae-companies-make",
        "destination": "https://diasuae.ae/blog/top-tax-mistakes-uae-companies-make",
        "type": 301
      },
      {
        "source": "/blog/draft-free-zone-qualifying-income",
        "destination": "https://diasuae.ae/blog/free-zone-qualifying-income",
        "type": 301
      },
      {
        "source": "/blogs/draft-free-zone-qualifying-income",
        "destination": "https://diasuae.ae/blog/free-zone-qualifying-income",
        "type": 301
      },
      {
        "source": "/blog/draft-claim-small-business-relief",
        "destination": "https://diasuae.ae/blog/claim-small-business-relief",
        "type": 301
      },
      {
        "source": "/blogs/draft-claim-small-business-relief",
        "destination": "https://diasuae.ae/blog/claim-small-business-relief",
        "type": 301
      },
      {
        "source": "/blog/draft-vat-registration-checklist",
        "destination": "https://diasuae.ae/blog/vat-compliance-checklist",
        "type": 301
      },
      {
        "source": "/blogs/draft-vat-registration-checklist",
        "destination": "https://diasuae.ae/blog/vat-compliance-checklist",
        "type": 301
      },
      {
        "source": "/blog/draft-backlog-bookkeeping-penalty-shield",
        "destination": "https://diasuae.ae/services/backlog-accounting",
        "type": 301
      },
      {
        "source": "/blogs/draft-backlog-bookkeeping-penalty-shield",
        "destination": "https://diasuae.ae/services/backlog-accounting",
        "type": 301
      },
      {
        "regex": "^/blogs?/draft-.+$",
        "destination": "https://diasuae.ae/blog",
        "type": 301
      },
      {
        "source": "/blogs/:slug",
        "destination": "https://diasuae.ae/blog/:slug",
        "type": 301
      },
      {
        "source": "/corporate-tax-calculator",
        "destination": "https://diasuae.ae/uae-tax-planner",
        "type": 301
      },
      {
        "source": "/tax-savings",
        "destination": "https://diasuae.ae/uae-tax-planner",
        "type": 301
      },
      {
        "source": "/tax-savings-assessment",
        "destination": "https://diasuae.ae/uae-tax-planner",
        "type": 301
      },
      {
        "source": "/dividends-audit-dubai",
        "destination": "https://diasuae.ae/dividends-audit",
        "type": 301
      },
      {
        "source": "/dividends-audit-uae",
        "destination": "https://diasuae.ae/dividends-audit",
        "type": 301
      },
      {
        "source": "/business-incorporation",
        "destination": "https://diasuae.ae/services/business-incorporation",
        "type": 301
      },
      {
        "source": "/business-incorporation-services",
        "destination": "https://diasuae.ae/services/business-incorporation",
        "type": 301
      },
      {
        "source": "/services/business-incorporation-services",
        "destination": "https://diasuae.ae/services/business-incorporation",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/corporate-tax-consulting-dubai",
        "destination": "/corporate-tax-consulting-dubai.html"
      },
      {
        "source": "/tax-services-dubai",
        "destination": "/tax-services-dubai.html"
      },
      {
        "source": "/accounting-services-uae",
        "destination": "/accounting-services-uae.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/llms-full.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ]
  }
}
