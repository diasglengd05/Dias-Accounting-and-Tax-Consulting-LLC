{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/home",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/home.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/index.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tax-planning-difc.html",
        "destination": "/tax-planning-difc",
        "type": 301
      },
      {
        "source": "/blogs",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blogs/",
        "destination": "/blog",
        "type": 301
      },
      {
        "source": "/blog/draft-top-tax-mistakes-uae-companies-make",
        "destination": "/blog/top-tax-mistakes-uae-companies-make",
        "type": 301
      },
      {
        "source": "/blogs/draft-top-tax-mistakes-uae-companies-make",
        "destination": "/blog/top-tax-mistakes-uae-companies-make",
        "type": 301
      },
      {
        "source": "/blogs/:slug",
        "destination": "/blog/:slug",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/corporate-tax-consulting-dubai",
        "destination": "/corporate-tax-consulting-dubai.html"
      },
      {
        "source": "/tax-services-dubai",
        "destination": "/tax-services-dubai.html"
      },
      {
        "source": "/accounting-services-uae",
        "destination": "/accounting-services-uae.html"
      },
      {
        "source": "/tax-planning-difc",
        "destination": "/tax-planning-difc.html"
      },
      {
        "source": "/blog",
        "destination": "/blog.html"
      },
      {
        "regex": "^(?!/llms\\.txt$|/robots\\.txt$|/sitemap\\.xml$).*",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "application/xml; charset=utf-8"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          },
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          }
        ]
      }
    ]
  }
}
