# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Password used to access the Advisor Admin Portal. Defaults to 'dias2026' if unset.
ADMIN_PASSWORD=

# VITE_GOOGLE_APPS_SCRIPT_URL: The Google Apps Script deployed web app URL for direct Google Sheet logging.
VITE_GOOGLE_APPS_SCRIPT_URL=

# SMTP Configuration (Optional): For sending Playbook PDF confirmation emails to clients
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=consulting@diasaccounting.ae

# Admin Lead Notification Email (Optional): Receives instant alerts on new leads & playbook downloads
ADMIN_NOTIFICATION_EMAIL=diasglen.gd@gmail.com

# VITE_GOOGLE_MAPS_API_KEY (Optional): Google Maps Platform API key for embedded maps
VITE_GOOGLE_MAPS_API_KEY=

# CRON_SECRET (Optional): Authorization secret key to authenticate Google Cloud Function and Cloud Scheduler HTTP triggers.
CRON_SECRET=
